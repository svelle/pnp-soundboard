# D&D Soundboard Environment Variables

# Server port (default: 3000)
PORT=3000

# Website password (protects entire site via nginx)
# IMPORTANT: Change this to a secure password!
# This password is used for HTTP Basic Authentication at the nginx level
# Username: admin
SOUNDBOARD_PASSWORD=your-secure-password-here

# Domain Configuration (for nginx + SSL)
# Your domain name (e.g., soundboard.example.com)
# Make sure your domain's DNS points to your server's IP address
DOMAIN=soundboard.example.com
